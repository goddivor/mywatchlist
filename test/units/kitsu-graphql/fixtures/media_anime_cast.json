   "quotes": {
    "nodes": [
     {
      "id": "557",
      "lines": {
       "nodes": [
        {
         "content": "Lesson! Lesson! If you see a stranger, follow him.",
         "character": {
          "names": {
           "canonical": "Edward Wong Hau Pepelu Tivrusky IV"
          }
         }
        }
       ]
      }
     },
     {
      "id": "231",
      "lines": {
       "nodes": [
        {
         "content": "The past is the past and the future is the future. A man is a man and a woman is a woman. The present is the present. I am who I am and you are who you are. That's all there is to it. Does it really matter? Or do we just think it does?",
         "character": {
          "names": {
           "canonical": "Faye Valentine"
          }
         }
        }
       ]
      }
     },
     {
      "id": "230",
      "lines": {
       "nodes": [
        {
         "content": "Bang.",
         "character": {
          "names": {
           "canonical": "Spike Spiegel"
          }
         }
        }
       ]
      }
     },
     {
      "id": "361",
      "lines": {
       "nodes": [
        {
         "content": "Don't you wanna hang out and waste your life with us?",
         "character": {
          "names": {
           "canonical": "Spike Spiegel"
          }
         }
        }
       ]
      }
     },
     {
      "id": "370",
      "lines": {
       "nodes": [
        {
         "content": "Do not fear Death. Death is always at our side. When we show fear, it jumps at us faster than light. But, if we do not show fear, it casts its eye upon us gently and then guides us into infinity.",
         "character": {
          "names": {
           "canonical": "Laughing Bull"
          }
         }
        }
       ]
      }
     }
    ]
   },
