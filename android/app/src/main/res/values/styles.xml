<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launch window before the Flutter engine draws: dark navy and the centred MWL logo
         (launch_background). Identical in light and dark system modes. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Window behind the Flutter UI until its first frame: same navy, so no white flash. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
