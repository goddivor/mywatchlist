# Localization build outputs, regenerated by tools/l10n/build.sh (sources: lib/l10n/**)
/lib/generated/l10n.dart
/lib/generated/intl/
# The l10n tool pins its generator: keep its lock file
!/tools/l10n/pubspec.lock
