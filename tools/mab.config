# multi-agent-build configuration — copy to <project>/tools/mab.config and commit it.
# Read by bash (sourced) and by node (KEY=value lines). Rules for both to agree:
#   - one KEY=value per line, no spaces around '=', no 'export', no arrays;
#   - quote with single quotes when the value holds '$' that must expand LATER (at verify time);
#   - never put a secret here.
# Paths are relative to the project directory (the folder holding tools/mab.config).

# ---- GitHub -----------------------------------------------------------------------------------
OWNER=goddivor # user or organisation owning the repositories and the board
PROJECT_NUMBER=8 # GitHub Project (v2) number holding one card per unit issue
STATUS_TODO=Todo                      # option names of the board's Status field
STATUS_INPROGRESS="In Progress"
STATUS_DONE=Done

# ---- Branches ---------------------------------------------------------------------------------
BASE_BRANCH=dev                       # unit branches start here and merge back here (squash)
RELEASE_BRANCH=master # promoted by the owner only — no script ever touches it

# ---- Components -------------------------------------------------------------------------------
# One entry per git repository that carries a unit queue. A single-repo project lists one name.
# Component names: lowercase letters, digits, '_' (they become variable suffixes).
COMPONENTS="root"
COORD_COMPONENT=root                  # the repository holding the coordination issue

REPO_root=goddivor/mywatchlist # owner/name on GitHub
PATH_root=.                           # checkout path, relative to the project directory
QUEUE_root=work/units.json            # emitted by work/_generate-units.mjs (see references/setup.md)
INDEX_root=work/INDEX.md              # the generated index whose Status column is hand-updated
GENERATOR_root="node work/_generate-units.mjs"
SETUP_root="flutter pub get" # run in a fresh worktree / before verify, e.g. "npm ci"
VERIFY_root="tools/heavy.sh tools/verify.sh"
VERIFY_ENV_root=''                    # e.g. 'export DATABASE_URL=postgres://localhost/review_$MAB_PR'
FORMAT_root="" # the project's formatter, run after a rebase, e.g. "cargo fmt"
# LINK_root="node_modules"            # paths symlinked from the main checkout into each worktree
COPY_root="assets/.env"              # paths copied into each worktree (never committed)

# Example second component (uncomment and add to COMPONENTS="root server"):
# REPO_server=your-github-user/your-repo-server
# PATH_server=server
# QUEUE_server=work/units.json
# INDEX_server=work/INDEX.md
# GENERATOR_server="node work/_generate-units.mjs"
# SETUP_server=""
# VERIFY_server="scripts/verify.sh"
# VERIFY_ENV_server='export DATABASE_URL=postgres://localhost/review_$MAB_PR'
# FORMAT_server="cargo fmt"

# ---- Context files (project-forge layout) -----------------------------------------------------
STATE_FILE=PROJECT-STATE.md           # resolved "ours" on a rebase conflict, reset to base if over cap
UNION_FILES=docs/DECISIONS.md # append-only logs: a rebase conflict keeps both sides
AUDIT_CMD=""
AUDIT_OVER_PATTERN=OVER
STATE_CAP_LINES=80                    # fallback cap when AUDIT_CMD is empty or missing

# ---- Merge ------------------------------------------------------------------------------------
OWNS_CHECK=strict                     # strict | warn | off — files outside the unit's owns list
OWNS_ALWAYS=""                         # extra files any unit may touch (STATE_FILE and UNION_FILES always may)
ATTRIBUTION_PATTERN='co-authored-by:|generated with|noreply@anthropic\.com|🤖'
MARK_DONE=1                           # after a merge: Status ✅ done in INDEX, regenerate, push base
MERGE_RETRIES=5
MERGE_RETRY_SLEEP=20
CHECK_EVERY=4 # merges between two independent checker agents

# ---- Machine ----------------------------------------------------------------------------------
MAX_AGENTS=4 # agents running at once (owner's ceiling)
PORT_BASE=4100                        # agent k gets PORT_BASE + 10*k .. +9
CLAIM_SETTLE=20                       # seconds to wait before re-reading a claim (race window)
WT_DIR=.wt                            # worktrees live in <component>/<WT_DIR>/<issue>
STATE_DIR=tools/.mab                  # logs, locks, pid files (git-excluded, survives reboots)
